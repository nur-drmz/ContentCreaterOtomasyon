# Copy this file to .env and fill in real values locally, or set these as
# Colab Secrets (left panel -> key icon). Never commit a real .env file or
# paste real keys into a notebook cell.

# --- Google / Gemini (PRIMARY provider: script, hot-moment review, bulk work,
#     grounded research, TTS, embeddings -- all through local_pipeline/google_ai.py)
# In Colab Secrets the name is GeminiKey; GOOGLE_API_KEY is kept as a
# backward-compatible alias and is tried second.
GeminiKey=
GOOGLE_API_KEY=
# Optional MANUALLY selected secondary project profile. The notebook never
# rotates to it automatically and it must not be used to evade provider quota.
GeminiKeySecondary=

# --- Optional cross-provider fallback (skipped cleanly when absent) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# NVIDIA NIM (build.nvidia.com) - OpenAI-compatible chat endpoint
NVIDIA_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Text-to-speech (production-quality narration) ---
ELEVENLABS_API_KEY=

# --- Trend / opportunity scoring (Notebook 04) ---
TMDB_API_KEY=

# --- Optional stock video search for Long-form B-roll --------------------
# Searches only run after an explicit button press. Keys never reach the UI.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- YouTube Data API v3 (Notebook 04 enrichment; public metadata only) ---
# In Colab Secrets the name is YoutubeKEY; YOUTUBE_DATA_API_KEY is the
# backward-compatible alias, tried second. NOT the same key as GeminiKey.
YoutubeKEY=
YOUTUBE_DATA_API_KEY=
YoutubeKEYSecondary=

# --- YouTube Analytics API (OAuth, authenticated channel only; not yet wired into a notebook) ---
# Populated via an OAuth flow, not a static key. Placeholder for future use.
YOUTUBE_OAUTH_CLIENT_SECRETS_PATH=

# --- Local-only knobs (optional) ---
# Set to 1 to opt into local GPU transcription in Notebook 01 when not on Colab.
YOUTUBE_AUTOMATION_USE_GPU=

# Completed projects can be moved out of the active workspace from the
# Creator Console "Arsivle" button. Example on Windows:
CREATOR_CONSOLE_ARCHIVE_ROOT=G:\Youtube kaynak videolar
# Optional server-side source library. Videos here appear in Faz 0 and are
# copied into the selected project without crossing the browser upload path.
CREATOR_CONSOLE_SOURCE_LIBRARY_ROOT=G:\Youtube kaynak videolar
# Optional licensed music library. Each track may carry a sidecar named
# <dosya>.license.json with title, artist, license_id, source_url and
# verified_by. A track WITHOUT a complete sidecar is still listed, but is
# marked "lisans dogrulanmadi" -- this project never calls a track royalty-free.
CREATOR_CONSOLE_MUSIC_ROOT=G:\Youtube muzik kutuphanesi

# --- GitHub private repository / future Console data sync -----------------
# Store only in .env.local. Never commit a real token.
GITHUB_TOKEN=
